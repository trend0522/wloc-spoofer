#!name=Apple WLOC 定位修改
#!desc=修改 Apple 網路定位回傳座標 | 快捷指令(推薦): 設定地理位置 https://www.icloud.com/shortcuts/a82717d8fdad4e6280866fcf911173f7 清除恢復位置 https://www.icloud.com/shortcuts/f42632d406504f24a2cd163af4fe012f
#!icon=https://raw.githubusercontent.com/trend0522/wloc-spoofer/refs/heads/main/wloc.jpg
#!author=ios151 Rewrite (fork by trend0522)
#!homepage=https://github.com/trend0522/wloc-spoofer
#!openUrl=https://wloc-spoofer.trend0522.workers.dev/

[Argument]
longitude = input, "113.94114", tag=經度（線上選點優先）
latitude = input, "22.544577", tag=緯度（線上選點優先）
accuracy = input, "25", tag=精度（公尺）
randomRadius = input, "0", tag=擾動半徑（公尺，0為關閉）
logLevel = select, "info", "off", "error", "warn", "debug", "all", tag=日誌等級

[Script]
http-response ^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc script-path=https://raw.githubusercontent.com/trend0522/wloc-spoofer/refs/heads/main/dist/wloc.js, requires-body=true, binary-body-mode=true, timeout=30, tag=Apple WLOC, argument=[{longitude},{latitude},{accuracy},{randomRadius},{logLevel}]
http-request ^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save script-path=https://raw.githubusercontent.com/trend0522/wloc-spoofer/refs/heads/main/dist/wloc-settings.js, timeout=10, tag=WLOC Settings

[MITM]
hostname = gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
