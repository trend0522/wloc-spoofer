name: Apple WLOC 定位修改
desc: "修改 Apple 網路定位回傳座標 | 快捷指令(推薦): 設定地理位置 https://www.icloud.com/shortcuts/a82717d8fdad4e6280866fcf911173f7 清除恢復位置 https://www.icloud.com/shortcuts/f42632d406504f24a2cd163af4fe012f | 選點頁面: https://wloc-spoofer.trend0522.workers.dev/"
author: ios151 Rewrite
homepage: https://github.com/trend0522/wloc-spoofer
icon: https://raw.githubusercontent.com/trend0522/wloc-spoofer/refs/heads/main/wloc.jpg
category: Tools

http:
  mitm:
    - "gs-loc.apple.com"
    - "gs-loc-cn.apple.com"
    - "gsp-ssl.ls.apple.com"
    - "bluedot.is.autonavi.com"
    - "bluedot.is.autonavi.com.gds.alibabadns.com"
  script:
    - match: ^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc
      name: WLOC.Location
      type: response
      require-body: true
      binary-mode: true
      max-size: 0
      timeout: 30
      argument: longitude=113.94114&latitude=22.544577&accuracy=25&randomRadius=0&logLevel=info
    - match: ^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save
      name: WLOC.Settings
      type: request
      require-body: false
      timeout: 10

script-providers:
  WLOC.Location:
    url: https://raw.githubusercontent.com/trend0522/wloc-spoofer/refs/heads/main/dist/wloc.js
    interval: 86400
  WLOC.Settings:
    url: https://raw.githubusercontent.com/trend0522/wloc-spoofer/refs/heads/main/dist/wloc-settings.js
    interval: 86400
